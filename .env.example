# API Configuration
# Set this to override the default backend URL
# If not set, the API client falls back to http://localhost:8080 (see src/api/custom-instance.ts)
# In production, set this to your backend URL
CONLUZ_API_URL=https://your-backend-domain.com

# App version shown in the side menu. Set automatically at image build time from
# the git tag (see docker/Dockerfile); leave unset locally to show "dev".
# CONLUZ_APP_VERSION=1.0.0
